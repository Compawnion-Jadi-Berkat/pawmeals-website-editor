# =============================================================================
# PAWMEALS WEBSITE — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in all values before running the app.
# NEVER commit .env.local to Git. It is already in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# SHOPIFY HEADLESS (Storefront API)
# Where to get: Shopify Admin → Settings → Apps → Develop Apps
# Create a new app, enable Storefront API, copy the token
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=pawmeals.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_api_token_here
SHOPIFY_ADMIN_API_TOKEN=your_admin_api_token_here
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here

# -----------------------------------------------------------------------------
# SANITY.IO (Headless CMS)
# Where to get: sanity.io/manage → your project → API → Tokens
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=your_sanity_api_token_here

# -----------------------------------------------------------------------------
# AWS RDS POSTGRESQL (Database)
# Where to get: AWS Console → RDS → Your Instance → Connectivity & Security
# Format: postgresql://USERNAME:PASSWORD@ENDPOINT:5432/DATABASE_NAME
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://pawmeals_user:your_password@your-rds-endpoint.rds.amazonaws.com:5432/pawmeals_db
DATABASE_URL_UNPOOLED=postgresql://pawmeals_user:your_password@your-rds-endpoint.rds.amazonaws.com:5432/pawmeals_db

# -----------------------------------------------------------------------------
# XENDIT (Indonesian Payment Gateway)
# Where to get: app.xendit.co → Settings → API Keys
# -----------------------------------------------------------------------------
XENDIT_SECRET_KEY=xnd_production_your_key_here
XENDIT_PUBLIC_KEY=xnd_public_your_key_here
XENDIT_WEBHOOK_TOKEN=your_xendit_webhook_token

# -----------------------------------------------------------------------------
# STRIPE (International Payments + Subscriptions)
# Where to get: dashboard.stripe.com → Developers → API Keys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# -----------------------------------------------------------------------------
# KLAVIYO (Email Marketing)
# Where to get: klaviyo.com → Account → Settings → API Keys
# -----------------------------------------------------------------------------
KLAVIYO_API_KEY=your_klaviyo_private_api_key
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=your_klaviyo_company_id

# -----------------------------------------------------------------------------
# GOOGLE TAG MANAGER + ANALYTICS
# Where to get: tagmanager.google.com and analytics.google.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# META PIXEL (Facebook/Instagram Ads Attribution)
# Where to get: Meta Business Manager → Events Manager → Pixels
# -----------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id

# -----------------------------------------------------------------------------
# TIKTOK PIXEL
# Where to get: TikTok Ads Manager → Assets → Events → Web Events
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TIKTOK_PIXEL_ID=your_tiktok_pixel_id

# -----------------------------------------------------------------------------
# GORGIAS (Customer Service)
# Where to get: app.gorgias.com → Settings → Integrations → Chat
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GORGIAS_ACCOUNT=pawmeals
GORGIAS_API_KEY=your_gorgias_api_key

# -----------------------------------------------------------------------------
# WHATSAPP BUSINESS API (Order Confirmations)
# Where to get: Meta Business Manager → WhatsApp → API Setup
# Note: Not yet active — placeholder for future integration
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# -----------------------------------------------------------------------------
# N8N AUTOMATION (Webhook endpoints for AWS EC2 n8n instance)
# Where to get: Your n8n instance → Workflows → Webhook URLs
# -----------------------------------------------------------------------------
N8N_ORDER_WEBHOOK_URL=https://your-n8n-instance.com/webhook/new-order
N8N_USER_WEBHOOK_URL=https://your-n8n-instance.com/webhook/new-user

# -----------------------------------------------------------------------------
# APP CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://pawmeals.id
NEXT_PUBLIC_SITE_NAME=Pawmeals
JWT_SECRET=generate_a_strong_random_secret_here_min_32_chars
NEXTAUTH_SECRET=generate_another_strong_random_secret_here
NEXTAUTH_URL=https://pawmeals.id
