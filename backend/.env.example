# ─── SERVER ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── AWS RDS POSTGRESQL ───────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:5432/pawmeals_db?sslmode=require
DATABASE_URL=postgresql://cattodomain:YOUR_PASSWORD@corporate-database-1.cluster-cz4isw8uucq7.ap-southeast-1.rds.amazonaws.com:5432/pawmeals_db?sslmode=require

# ─── FRONTEND ─────────────────────────────────────────────────────────────────
# Your Vercel deployment URL or custom domain
FRONTEND_URL=https://pawmeals.com
VERCEL_URL=

# ─── JWT (Admin Dashboard Auth) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND

# ─── SHOPIFY ──────────────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=pawmeals.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=YOUR_STOREFRONT_TOKEN
SHOPIFY_ADMIN_ACCESS_TOKEN=YOUR_ADMIN_TOKEN
SHOPIFY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ─── KLAVIYO ──────────────────────────────────────────────────────────────────
KLAVIYO_API_KEY=YOUR_KLAVIYO_API_KEY
KLAVIYO_LIST_ID_ID=YOUR_ID_LIST_ID
KLAVIYO_LIST_ID_EN=YOUR_EN_LIST_ID

# ─── XENDIT ───────────────────────────────────────────────────────────────────
XENDIT_SECRET_KEY=YOUR_XENDIT_SECRET_KEY
XENDIT_WEBHOOK_TOKEN=YOUR_XENDIT_WEBHOOK_TOKEN

# ─── STRIPE ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# ─── n8n INTEGRATION ──────────────────────────────────────────────────────────
# URL of the n8n order confirmation webhook (running on this EC2)
N8N_ORDER_WEBHOOK_URL=http://localhost:5678/webhook/pawmeals-order-confirmation
N8N_WEBHOOK_SECRET=CHANGE_ME_RANDOM_SECRET

# ─── WHATSAPP BUSINESS API ────────────────────────────────────────────────────
# Will be added when WhatsApp Business API account is approved
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
